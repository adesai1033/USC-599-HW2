# LLM providers: verify and pin exact current model IDs
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=<verified-gemini-flash-model-id>

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=<verified-claude-sonnet-model-id>

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=<verified-openai-model-id>
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Real-time knowledge
TAVILY_API_KEY=your-tavily-api-key

# RAG / orchestration
CHROMA_PERSIST_DIR=./index/chroma
PAPERS_DB_PATH=./index/papers.sqlite
RAG_TOP_K=6
MAX_SUPERVISOR_STEPS=6
HISTORY_TURNS=6
MCP_SERVERS_CONFIG=./mcp_config.json

# Durable state: memory locally, firestore on Cloud Run
STATE_BACKEND=memory
FIRESTORE_PROJECT_ID=your-project-id

# Cloud Run deployment
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-west1
CLOUD_RUN_SERVICE=csci599-a2
