# Copy to .env for local runs. Placeholders only; never commit real keys.

# Server
PORT=8080
LOG_LEVEL=INFO

# LLM providers (model IDs verified 2026-10-21; see README)
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-3.8-flash

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6.1-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Real-time knowledge (Tavily Remote MCP; the key goes in the URL query string)
TAVILY_API_KEY=your-tavily-api-key

# RAG / orchestration
CHROMA_PERSIST_DIR=./index/chroma
PAPERS_DB_PATH=./index/papers.sqlite
RAG_TOP_K=6
MAX_SUPERVISOR_STEPS=6
HISTORY_TURNS=6
MCP_SERVERS_CONFIG=./mcp_config.json

# Durable state: memory locally, firestore on Cloud Run
STATE_BACKEND=memory
FIRESTORE_PROJECT_ID=usc-599-hw2

# Cloud Run deployment
GCP_PROJECT_ID=usc-599-hw2
GCP_REGION=us-west1
CLOUD_RUN_SERVICE=paper-assistant
