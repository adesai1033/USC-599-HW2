# macOS
.DS_Store
.AppleDouble
.LSOverride

# Environment / secrets (never commit .env — ship .env.example instead)
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
service-account*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.python-version
.pytest_cache/

# Virtual environments
.venv/
.venv-eval/
venv/
env/
ENV/

# Vector store / RAG index artifacts
chroma_index/
chroma_db/
*.sqlite3
*.chroma
# Prebuilt index/ (Chroma + papers.sqlite) is baked into the image, never committed
index/

# Ingestion intermediates (raw PDFs, parsed JSON)
data/

# Durable state / local checkpoints
*.db
checkpoints/

# Testing / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE / editor
.vscode/
.idea/
*.swp

# Logs and temp files
*.log
tmp/

# Node (only if frontend tooling ever gets added — assignment forbids node_modules in the image)
node_modules/

# GCP / deploy artifacts
.gcloudignore-generated
*.tar.gz

# Eval answer files hold full paper chunk texts; keep only scores, summaries and latency runs.
eval/results/*.jsonl
!eval/results/*.scores.jsonl
!eval/results/latency-*.jsonl
